# Copy to .env.local for local dev. On Render, set these in the dashboard (render.yaml lists them).

# --- Anthropic: hidden judge, larp-gap estimator, claim suggester, summarizer ---
ANTHROPIC_API_KEY=
# Runs on every user turn: fast and cheap.
JUDGE_MODEL=claude-haiku-5-5
# Pre-scene larp-gap estimate and claim suggestions.
GAP_MODEL=claude-haiku-5-5
# End-of-scene debrief.
SUMMARY_MODEL=claude-opus-5-5

# --- ElevenLabs: the NPC (speech-to-text, conversation LLM, text-to-speech) ---
ELEVENLABS_API_KEY=
# Create these with `npm run agents:create` (it prints the lines to paste here).
ELEVENLABS_AGENT_ID_RECRUITER=
ELEVENLABS_AGENT_ID_NETWORKING=
ELEVENLABS_AGENT_ID_CUSTOM=
# Group scenes (one multi-voice agent each).
ELEVENLABS_AGENT_ID_PARTY=
ELEVENLABS_AGENT_ID_GROUP=

# --- Supabase: accounts (email + password) and saved games. Both values are public-safe. ---
# Leave empty to run without accounts (local dev only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Agentboxd (optional): the handler inbox that emails a brief before and a debrief after ---
AGENTBOXD_API_KEY=
AGENTBOXD_HANDLER_CLIENT_ID=sus-handler

# Optional: public URL used in debrief emails (Render sets RENDER_EXTERNAL_URL automatically).
PUBLIC_APP_URL=

# Development aid only: canned LLM output + scripted NPC so the UI runs without keys.
# Also turns on automatically in `npm run dev` when the matching API key is missing.
MOCK_MODE=

# Copy to .env.local for local dev. On Vercel, set these as the project's environment variables.

# --- Anthropic: hidden judge, larp-gap estimator, claim suggester, summarizer ---
ANTHROPIC_API_KEY=
# Runs on every user turn: fast and cheap.
JUDGE_MODEL=claude-haiku-5-5
# Pre-scene larp-gap estimate and claim suggestions.
GAP_MODEL=claude-haiku-5-5
# End-of-scene debrief.
SUMMARY_MODEL=claude-sonnet-5-5

# --- ElevenLabs: the NPC (speech-to-text, conversation LLM, text-to-speech) ---
ELEVENLABS_API_KEY=
# The agents' IDs live in src/lib/agents.json, written by `npm run agents:create`.

# --- Supabase: accounts (email + password) and saved games. Both values are public-safe. ---
# Leave empty to run without accounts (local dev only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (bypasses row-level security; never prefix it with NEXT_PUBLIC_). Needed with accounts:
# only the server saves finished games to players' history. It also keeps live sessions in Supabase
# (game_sessions table), so restarts and deploys don't drop calls in progress. Without it, live
# sessions are kept in this server's memory and games aren't saved.
SUPABASE_SECRET_KEY=

# Signs larp-gap estimates (any long random string, e.g. `openssl rand -base64 32`). Optional
# locally: without it, a restart just means the gap is estimated again when the scene starts.
APP_SECRET=

# Log each model call's latency and prompt-cache use (cache read / cache write tokens).
LLM_DEBUG=

# Development aid only: canned LLM output + scripted NPC so the UI runs without keys.
# Also turns on automatically in `npm run dev` when the matching API key is missing.
MOCK_MODE=

{
  "name": "suspeeches",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint",
    "test:judge": "tsx --env-file-if-exists=.env.local scripts/test-judge.ts",
    "agents:create": "tsx --env-file-if-exists=.env.local scripts/create-agents.ts",
    "typecheck": "tsc --noEmit",
    "agents:update": "tsx --env-file-if-exists=.env.local scripts/create-agents.ts --update",
    "dev:mock": "MOCK_MODE=1 NEXT_PUBLIC_SUPABASE_URL= next dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@elevenlabs/react": "^1.20.2",
    "@supabase/supabase-js": "^2.118.0",
    "agentboxd": "^0.3.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
